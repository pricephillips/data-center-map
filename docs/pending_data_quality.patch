+
+      # Spec 005. Both run after every generator, so they read this run's
+      # outputs. configs/data_quality.json schema.mode decides whether the
+      # schema blocks: in window mode it reports until seven consecutive clean
+      # runs, then blocks. The surface steps at the end turn a failure red
+      # after the feed is committed, like the other fenced steps.
+      - name: Data quality schemas (qc/schemas.py)
+        id: schemas
+        continue-on-error: true
+        run: python qc/schemas.py
+
+      - name: Coverage delta (a declared column may not collapse)
+        id: coverage_delta
+        continue-on-error: true
